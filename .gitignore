# Unity generated (project lives in SatelliteFixer/; anchored so folders inside Assets/ are not ignored)
/SatelliteFixer/[Ll]ibrary/
/SatelliteFixer/[Tt]emp/
/SatelliteFixer/[Oo]bj/
/SatelliteFixer/[Bb]uild/
/SatelliteFixer/[Bb]uilds/
/SatelliteFixer/[Ll]ogs/
/SatelliteFixer/[Uu]ser[Ss]ettings/
/SatelliteFixer/[Mm]emoryCaptures/
/SatelliteFixer/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/SatelliteFixer/[Aa]ssets/**/*.meta

# Autogenerated IDE / project files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
