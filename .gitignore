*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports / builds
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app

# Addressables / StreamingAssets generated
/SatelliteFixer/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/SatelliteFixer/[Aa]ssets/[Ss]treamingAssets/aa.meta
/SatelliteFixer/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
